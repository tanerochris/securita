# App
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (Compose service name "db" by default)
DATABASE_URL=postgresql+psycopg://agent:agent@db:5432/agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent

# Per-install master key (base64, 32 bytes). Generate once, store outside the install.
# Example: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=

# Model brain (Muse Spark via OpenAI-compatible Chat Completions)
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
MODEL_NAME=muse-spark

# Policy RAG embeddings — pick ONE provider. Vectors are optional:
# chunks without embeddings still serve via keyword retrieval.
#   local  (default) in-process ONNX model (fastembed), no extra service
#   ollama heavier server option: EMBEDDING_PROVIDER=ollama plus
#          `docker compose --profile ollama up -d`
#   hosted any OpenAI-compatible /embeddings API (set BASE_URL + KEY)
#   off    keyword retrieval only
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_LOCAL_CACHE_DIR=
EMBEDDING_DIM=1536
# Policy ingestion/retrieval budgets.
POLICY_CHUNK_CHARS=2000
POLICY_CHUNK_OVERLAP_CHARS=200
POLICY_TOP_K=6
POLICY_PROMPT_BUDGET_CHARS=8000
POLICY_UPLOAD_MAX_BYTES=1000000
POLICY_MAX_CHUNKS_PER_DOC=200
POLICY_README_MAX_BYTES=200000

# Git provider connect (PAT-only): users paste a personal access token per
# provider (see docs/git-providers.md). Nothing to register. These are just
# the default hosts offered in the connect form; self-hosted users override.
GITHUB_BASE_URL=https://github.com
GITLAB_BASE_URL=https://gitlab.com

# SSO (Google / Microsoft OIDC) — operator-created clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Public base URL (redirect URIs: $PUBLIC_URL/auth/{google,microsoft}/callback).
# Must be https in prod; plain http allowed on localhost only (NFR-3).
PUBLIC_URL=http://localhost:8000

# Bot identity for delivery commits (FR-5 D3); SSH key signs when configured.
BOT_NAME=security-agent-bot
BOT_EMAIL=security-agent@localhost
BOT_SIGNING_KEY=

# Tier-2 news signals (FR-6): HN Algolia query + outlet RSS/Atom feeds.
NEWS_HN_QUERY=CVE
NEWS_RSS_FEEDS=
NEWS_POLL_HOURS=1.0
# Standalone news intel: LLM classification + news-driven findings.
NEWS_CLASSIFY_ENABLED=true
NEWS_CLASSIFY_MAX_ITEMS=20
NEWS_MINT_ENABLED=true
# Localized feed: per-repo relevance of each major story, judged by the
# model against that repo's stack + plausible deployment targets.
NEWS_RELEVANCE_ENABLED=true
NEWS_RELEVANCE_MAX_PAIRS=50

# Secrets loop (FR-8): explicit Betterleaks config (default rules when empty).
SECRETS_CONFIG_PATH=

# Sandbox execution (follow-up #1): auto|docker|host; prod forces docker.
SANDBOX_BACKEND=auto
SANDBOX_IMAGE=security-agent-sandbox:latest
SANDBOX_WORK_ROOT=
SANDBOX_NETWORK=none
# Audit backend (follow-up #2): memory|loki
AUDIT_BACKEND=memory
LOKI_URL=http://loki:3100
LOKI_TENANT=
# Model patch adaptation (follow-up #3)
MODEL_ADAPT_ENABLED=false
# Model-written PR titles/bodies (template fallback when false/keyless)
PR_TEXT_MODEL_ENABLED=true
NEWS_HN_MAX_PAGES=5

# Cost control (NFR-8 D4/D5): per-run token cap + daily spend alerts.
RUN_TOKEN_CAP=1000000
RUN_TOKEN_WARN_FRACTION=0.8
SPEND_WARN_DAILY_USD=25
SPEND_CRITICAL_DAILY_USD=100
MODEL_PRICE_PER_MTOK_USD=2.0

# Recovery (NFR-9 D1/D2): backup dir (bind mount) + key-ceremony file.
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=14
MASTER_KEY_FILE=./master.key
